{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>/tests"],
  "testMatch": ["**/*.test.ts"],
  "moduleNameMapper": {
    "^../../../shared/(.*)$": "<rootDir>/../shared/$1"
  },
  "collectCoverageFrom": [
    "src/**/*.ts",
    "!src/app.ts",
    "!src/**/*.d.ts"
  ],
  "coverageReporters": ["text", "lcov", "html"],
  "coverageDirectory": "coverage",
  "setupFilesAfterFramework": [],
  "testTimeout": 30000,
  "globals": {
    "ts-jest": {
      "tsconfig": "tsconfig.json",
      "diagnostics": false
    }
  }
}
